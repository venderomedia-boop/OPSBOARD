# Resend inbound receiving
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Inbound policy. Comma-separated values.
EMAIL_INTAKE_ALLOWED_SENDERS=
EMAIL_INTAKE_ALLOWED_DOMAINS=

# Keep disabled outside local/self-test environments.
EMAIL_INTAKE_TEST_MODE=0

# Maximum JSON/webhook body size in bytes (default 1 MiB).
EMAIL_INTAKE_MAX_BODY_BYTES=1048576
