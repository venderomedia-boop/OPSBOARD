APP_DOMAIN=office.example.co.uk
ENGINEER_DOMAIN=engineer.example.co.uk
TLS_EMAIL=it@example.co.uk
APP_TAG=latest

# PostgreSQL
POSTGRES_DB=vendero
POSTGRES_USER=vendero
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Authentication
AUTH_REQUIRED=true
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_TOKEN_TTL_SECONDS=604800
BOOTSTRAP_ADMIN_EMAIL=admin@example.co.uk
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
BOOTSTRAP_ADMIN_NAME=Operations Administrator
COMPANY_NAME=Client Company

# Resend / email intake
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_API_KEY=
RESEND_FROM_EMAIL=
TIMESHEET_EMAIL_FROM=
EMAIL_INTAKE_ADDRESS=
EMAIL_INTAKE_ALLOWED_SENDERS=
EMAIL_INTAKE_ALLOWED_DOMAINS=

# Encrypted physical-server backup.
# Recommended: establish WireGuard/Tailscale first and use the private/VPN IP.
RESTIC_REPOSITORY=sftp:backupuser@100.64.0.10:/srv/vendero/restic
BACKUP_INTERVAL_SECONDS=21600
