{
  email {$TLS_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  @backend path /api/v1/* /media/* /exports/*
  reverse_proxy @backend phase1-api:3000

  @phase1Protected {
    path /api/phase1/*
    not path /api/phase1/email/inbound
  }
  forward_auth @phase1Protected phase1-api:3000 {
    uri /api/v1/auth/verify
  }

  @phase1 path /api/phase1/*
  reverse_proxy @phase1 dispatchboard:8080

  reverse_proxy dispatchboard:8080
}


{$ENGINEER_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  @backend path /api/v1/* /media/* /exports/*
  reverse_proxy @backend phase1-api:3000

  reverse_proxy engineer:80
}
